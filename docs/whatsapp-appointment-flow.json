{
    "version": "8.0",
    "data_api_version": "3.0",
    "routing_model": {
        "APPOINTMENT": [
            "DETAILS"
        ],
        "DETAILS": [
            "TERMS"
        ],
        "TERMS": [
            "SUMMARY"
        ],
        "SUMMARY": []
    },
    "screens": [
        {
            "id": "APPOINTMENT",
            "title": "Book appointment",
            "data": {
                "age": {
                    "type": "number",
                    "__example__": 35
                },
                "date": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            }
                        }
                    },
                    "__example__": [
                        {
                            "id": "2026-09-02",
                            "title": "Wed Sep 02"
                        },
                        {
                            "id": "2026-09-03",
                            "title": "Thu Sep 03"
                        },
                        {
                            "id": "2026-09-04",
                            "title": "Fri Sep 04"
                        },
                        {
                            "id": "2026-09-05",
                            "title": "Sat Sep 05"
                        },
                        {
                            "id": "2026-09-07",
                            "title": "Mon Sep 07"
                        },
                        {
                            "id": "2026-09-08",
                            "title": "Tue Sep 08"
                        },
                        {
                            "id": "2026-09-09",
                            "title": "Wed Sep 09"
                        },
                        {
                            "id": "2026-09-10",
                            "title": "Thu Sep 10"
                        },
                        {
                            "id": "2026-09-11",
                            "title": "Fri Sep 11"
                        },
                        {
                            "id": "2026-09-12",
                            "title": "Sat Sep 12"
                        }
                    ]
                },
                "time": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            }
                        }
                    },
                    "__example__": [
                        {
                            "id": "10:00",
                            "title": "10:00 AM"
                        },
                        {
                            "id": "18:00",
                            "title": "6:00 PM"
                        }
                    ]
                },
                "time_enabled": {
                    "type": "boolean",
                    "__example__": false
                },
                "gender": {
                    "type": "string",
                    "__example__": "M"
                },
                "gender_options": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            }
                        }
                    },
                    "__example__": [
                        {
                            "id": "M",
                            "title": "Male"
                        },
                        {
                            "id": "F",
                            "title": "Female"
                        }
                    ]
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Ramachandra Ortho & Trauma Care"
                    },
                    {
                        "type": "TextBody",
                        "text": "Clinic is open Mon–Sat, closed Sunday. Pick a date to see real open times."
                    },
                    {
                        "type": "Form",
                        "name": "appointment_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "label": "Age",
                                "name": "age",
                                "input-type": "number",
                                "required": true
                            },
                            {
                                "type": "Dropdown",
                                "label": "Gender",
                                "name": "gender",
                                "data-source": "${data.gender_options}",
                                "required": true
                            },
                            {
                                "type": "Dropdown",
                                "label": "Preferred date",
                                "name": "date",
                                "data-source": "${data.date}",
                                "required": true,
                                "on-select-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "age": "${form.age}",
                                        "gender": "${form.gender}",
                                        "date": "${form.date}"
                                    }
                                }
                            },
                            {
                                "type": "Dropdown",
                                "label": "Preferred time",
                                "name": "time",
                                "data-source": "${data.time}",
                                "enabled": "${data.time_enabled}",
                                "required": "${data.time_enabled}"
                            },
                            {
                                "type": "Footer",
                                "label": "Continue",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "DETAILS"
                                    },
                                    "payload": {
                                        "age": "${form.age}",
                                        "gender": "${form.gender}",
                                        "date": "${form.date}",
                                        "time": "${form.time}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "DETAILS",
            "title": "Your details",
            "data": {
                "age": {
                    "type": "number",
                    "__example__": 35
                },
                "date": {
                    "type": "string",
                    "__example__": "2026-09-02"
                },
                "time": {
                    "type": "string",
                    "__example__": "10:00"
                },
                "gender": {
                    "type": "string",
                    "__example__": "M"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "details_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "label": "Patient name",
                                "name": "name",
                                "required": true
                            },
                            {
                                "type": "TextInput",
                                "label": "Phone number",
                                "name": "phone",
                                "input-type": "phone",
                                "required": true
                            },
                            {
                                "type": "TextArea",
                                "label": "Anything the doctor should know?",
                                "name": "notes",
                                "helper-text": "Optional — e.g. old reports, ongoing medication",
                                "required": false
                            },
                            {
                                "type": "Footer",
                                "label": "Continue",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "TERMS"
                                    },
                                    "payload": {
                                        "age": "${data.age}",
                                        "gender": "${data.gender}",
                                        "date": "${data.date}",
                                        "time": "${data.time}",
                                        "name": "${form.name}",
                                        "phone": "${form.phone}",
                                        "notes": "${form.notes}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "SUMMARY",
            "title": "Confirm",
            "terminal": true,
            "data": {
                "age": {
                    "type": "number",
                    "__example__": 35
                },
                "date": {
                    "type": "string",
                    "__example__": "Wed Sep 02"
                },
                "time": {
                    "type": "string",
                    "__example__": "10:00 AM"
                },
                "name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "phone": {
                    "type": "string",
                    "__example__": "9876543210"
                },
                "notes": {
                    "type": "string",
                    "__example__": ""
                },
                "gender": {
                    "type": "string",
                    "__example__": "M"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "confirmation_form",
                        "children": [
                            {
                                "type": "TextHeading",
                                "text": "Appointment request"
                            },
                            {
                                "type": "TextBody",
                                "text": "Preferred: ${data.date}, ${data.time}"
                            },
                            {
                                "type": "TextHeading",
                                "text": "Your details"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.name}\n${data.phone}"
                            },
                            {
                                "type": "TextBody",
                                "text": "${data.notes}"
                            },
                            {
                                "type": "Footer",
                                "label": "Confirm Appointment",
                                "on-click-action": {
                                    "name": "complete",
                                    "payload": {
                                        "age": "${data.age}",
                                        "gender": "${data.gender}",
                                        "date": "${data.date}",
                                        "time": "${data.time}",
                                        "name": "${data.name}",
                                        "phone": "${data.phone}",
                                        "notes": "${data.notes}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "TERMS",
            "title": "Appointment policy",
            "data": {
                "age": {
                    "type": "number",
                    "__example__": 35
                },
                "date": {
                    "type": "string",
                    "__example__": "Wed Sep 02"
                },
                "time": {
                    "type": "string",
                    "__example__": "10:00 AM"
                },
                "name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "phone": {
                    "type": "string",
                    "__example__": "9876543210"
                },
                "notes": {
                    "type": "string",
                    "__example__": ""
                },
                "gender": {
                    "type": "string",
                    "__example__": "M"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Before you confirm"
                    },
                    {
                        "type": "TextBody",
                        "text": "This is a request for a token, not a fixed time slot — we'll message you back on WhatsApp with the exact time once the desk confirms it against the day's schedule.\n\nPlease arrive a few minutes before your preferred window. If you miss your turn, it's automatically moved to the next working day, no need to rebook.\n\nPlans changed? Reply Cancel in this chat and we'll release your token.\n\nConsultation fee is payable at the clinic."
                    },
                    {
                        "type": "OptIn",
                        "name": "terms",
                        "label": "I agree to the appointment policy",
                        "required": true
                    },
                    {
                        "type": "Footer",
                        "label": "Continue",
                        "on-click-action": {
                            "name": "navigate",
                            "next": {
                                "type": "screen",
                                "name": "SUMMARY"
                            },
                            "payload": {
                                "age": "${data.age}",
                                "gender": "${data.gender}",
                                "date": "${data.date}",
                                "time": "${data.time}",
                                "name": "${data.name}",
                                "phone": "${data.phone}",
                                "notes": "${data.notes}"
                            }
                        }
                    }
                ]
            }
        }
    ]
}
