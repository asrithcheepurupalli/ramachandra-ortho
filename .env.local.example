# Supabase — copy to .env.local and fill from Supabase → Project Settings → API.
# When these are set, the app uses the real database; when empty, it runs on the
# zero-config mock store (localStorage) so dev + demos still work offline.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (used by /api/book and /api/slots to mediate public access).
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Staff allowlist for /admin now lives in the database (public.staff_emails,
# see supabase/schema.sql) instead of an env var here — public signup is on,
# so a session alone isn't proof of staff. Add staff by inserting into that
# table, not by setting anything in this file.

# Meta WhatsApp Cloud API — direct integration (AiSensy dropped: its Free
# Forever tier turned out to have no programmatic send at all). Access to the
# Cloud API itself is free; billing is usage-based per message once sending.
# All server-only — never expose to the browser or commit the real values.
# See developers.facebook.com/apps → your app → WhatsApp → API Setup, and
# Business Settings → Users → System Users for a permanent token.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Any string you choose yourself — shared secret for the webhook handshake,
# not issued by Meta. Must match what you enter in the webhook config screen.
META_VERIFY_TOKEN=

# Exact template name (as shown in Meta Business Manager → Templates), plus
# the language code it was approved under (defaults to en_US if left blank).
META_TEMPLATE_CONFIRM=
META_TEMPLATE_CANCEL=
META_TEMPLATE_LANG=

# WhatsApp Flow endpoint encryption (RSA keypair). Generate with
# `node scripts/gen-whatsapp-flow-keys.mjs` (requires META_WHATSAPP_TOKEN +
# META_PHONE_NUMBER_ID already set) — it prints the private key PEM and
# uploads the matching public key to Meta in one step. Server-only, never
# commit or expose the real value.
META_FLOW_PRIVATE_KEY=

# Razorpay — Payment Links API for optional online fee payment (website +
# WhatsApp). Keys from Razorpay Dashboard -> Settings -> API Keys. Webhook
# secret is whatever you set when adding the webhook URL in Settings ->
# Webhooks (subscribe to the payment_link.paid event) — not issued by
# Razorpay, chosen by you. All server-only, never commit or expose.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Needed to build the callback_url Razorpay redirects back to after payment,
# e.g. https://ramachandracare.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Optional: Meta-approved template for a WhatsApp payment-received notice.
# If unset, that notice is silently skipped, same fallback META_TEMPLATE_CONFIRM/
# META_TEMPLATE_CANCEL already have when unset.
META_TEMPLATE_PAID=
