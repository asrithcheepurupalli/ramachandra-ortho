# Supabase — copy to .env.local and fill from Supabase → Project Settings → API.
# When these are set, the app uses the real database; when empty, it runs on the
# zero-config mock store (localStorage) so dev + demos still work offline.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (used by /api/book and /api/slots to mediate public access).
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of staff emails allowed into /admin. Required once
# Supabase is configured — public signup is on, so a session alone isn't proof
# of staff. Without this set, nobody can reach /admin.
ADMIN_EMAILS=
